root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,md,yaml,yml}]
indent_style = space
indent_size = 2

[*.{sh,vim}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.cjs]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 80
